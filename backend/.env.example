# --- LLM models (any LiteLLM-compatible model id) ---
# Default: Google Gemini Flash (rolling alias to the latest stable Flash
# release). Create a key at https://aistudio.google.com/ (the free tier
# usually covers a small team) and set GEMINI_API_KEY.
# Note: pinned versions like gemini-2.5-flash may 404 ("no longer available
# to new users") on freshly created API keys — the rolling aliases
# (gemini-flash-latest / gemini-flash-lite-latest) stay valid.
LLM_MODEL=gemini/gemini-flash-latest
GEMINI_API_KEY=change-me

# Optional per-task overrides (each falls back to LLM_MODEL when unset):
#   COMPILE_MODEL — ingest-time compiler (hard task: use the strongest cheap model)
#   QUERY_MODEL   — chat pipeline (easier task: can be cheaper/faster)
#COMPILE_MODEL=gemini/gemini-flash-latest
#QUERY_MODEL=gemini/gemini-flash-lite-latest

# Anthropic alternative (set ANTHROPIC_API_KEY):
#LLM_MODEL=anthropic/claude-haiku-4-5

# Local via Ollama (dev/fallback only): runs on CPU/iGPU — NPUs are NOT used —
# so expect slow streaming. Small models often fail the verbatim compile gate;
# pair with COMPILE_REQUIRE_VERBATIM=false below.
#LLM_MODEL=ollama_chat/qwen3:4b

# Corrective retries when compile output fails validation (schema / verbatim /
# coverage). Total LLM attempts per ingest = 1 + COMPILE_MAX_RETRIES.
COMPILE_MAX_RETRIES=1

KNOWLEDGE_DIR=/path/to/your/obsidian-vault/team-kb

# Required. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
JWT_SECRET=change-me

# Optional
JWT_TTL_SECONDS=86400
ALLOWED_ORIGINS=["http://localhost:5173"]
# Flip on in production (HTTPS) so the session cookie is only sent over TLS.
COOKIE_SECURE=false
LOG_LEVEL=INFO
# Set false in production to hide /docs, /redoc, /openapi.json entirely.
EXPOSE_API_DOCS=true
# Reject ingest if compile output covers < this ratio of the raw document (fights over-summarization).
COMPILE_MIN_COVERAGE=0.7
# Set false to skip verbatim code-block/table preservation check (for weaker LLM models).
COMPILE_REQUIRE_VERBATIM=true
