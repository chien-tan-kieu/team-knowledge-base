## Any LiteLLM-compatible model identifier.
## Examples:
##   claude-sonnet-4-6                  — Anthropic (needs ANTHROPIC_API_KEY)
##   ollama_chat/<model>:<tag>          — Local Ollama chat (e.g. ollama_chat/qwen2.5:14b)
##   ollama/<model>:<tag>              — Local Ollama generate (e.g. ollama/llama3.2)
##   openai/gpt-4o                      — OpenAI (needs OPENAI_API_KEY)
LLM_MODEL=ollama_chat/qwen2.5:14b
KNOWLEDGE_DIR=knowledge

# Required. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
JWT_SECRET=change-me

# Optional
JWT_TTL_SECONDS=86400
ALLOWED_ORIGINS=["http://localhost:5173"]
# Flip on in production (HTTPS) so the session cookie is only sent over TLS.
COOKIE_SECURE=false
LOG_LEVEL=INFO
# Set false in production to hide /docs, /redoc, /openapi.json entirely.
EXPOSE_API_DOCS=true
# Reject ingest if compile output covers < this ratio of the raw document (fights over-summarization).
COMPILE_MIN_COVERAGE=0.7
# Set false to skip verbatim code-block/table preservation check (for weaker LLM models).
COMPILE_REQUIRE_VERBATIM=true
